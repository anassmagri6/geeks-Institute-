<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Music Library</title>
</head>
<body class="bg-gray-100 p-6">
  <nav class="bg-blue-600 text-white p-4 rounded mb-6 flex justify-between">
    <h1 class="font-bold">🎵 Music Library</h1>
    <div>
      <a href="/albums" class="mr-4">Albums</a>
      <a href="/artists" class="mr-4">Artists</a>
      <a href="/dashboard">Dashboard</a>
    </div>
  </nav>

  <div class="bg-white p-4 rounded shadow">
    <h2 class="text-xl font-bold mb-4">Albums List</h2>
    <table class="w-full text-left">
      <thead>
        <tr class="border-b"><th class="p-2">Title</th><th class="p-2">Artist</th></tr>
      </thead>
      <tbody>
        <% albums.forEach(album => { %>
          <tr class="border-b"><td class="p-2"><%= album.title %></td><td class="p-2"><%= album.artist ? album.artist.name : 'N/A' %></td></tr>
        <% }) %>
      </tbody>
    </table>

    <div class="mt-4 flex space-x-2">
      <% for(let i = 1; i <= totalPages; i++) { %>
        <a href="/albums?page=<%= i %>" class="px-3 py-1 bg-gray-200 rounded <%= currentPage === i ? 'bg-blue-500 text-white' : '' %>"><%= i %></a>
      <% } %>
    </div>
  </div>
</body>
</html>